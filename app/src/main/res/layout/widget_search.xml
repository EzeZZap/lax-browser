<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_search_background"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher_round" />

    <TextView
        android:id="@+id/widget_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:text="@string/widget_search_hint"
        android:textColor="@color/widget_text"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/widget_private"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_private_tab"
        android:padding="12dp"
        android:src="@drawable/ic_widget_private" />
</LinearLayout>
