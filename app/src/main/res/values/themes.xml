<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat parent: AppCompatActivity applies the per-app language on Android 12 and older. -->
    <style name="Theme.Lax" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Launch theme for the main browser: the icon's gradient badge on Lax's surface color. -->
    <style name="Theme.Lax.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Lax</item>
    </style>
</resources>
