<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device transfer. Only Lax's own data is copied: Spaces, containers,
  tabs, bookmarks, history, shortcuts, and settings (browser.db) plus the chosen app language.
  Gecko's profile (cookies, logins, site data, extensions), caches, crash logs, and downloads
  are left out, so restoring never carries sessions or site data to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="browser.db" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="browser.db" />
        <include domain="file" path="androidx.appcompat.app.AppCompatDelegate.application_locales_record_file" />
    </device-transfer>
</data-extraction-rules>
