<?xml version="1.0" encoding="utf-8"?>
<!--
  The preview layout, cell sizes, and optional configuration are Android 12+. Older launchers use
  the minimum sizes and show the Space chooser when the widget is added.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:configure="com.javzzap.laxbrowser.widget.SearchWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_search_description"
    android:initialLayout="@layout/widget_search"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_search"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
